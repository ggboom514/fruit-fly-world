{
  "name": "fruit-fly-pet",
  "version": "1.24.0",
  "description": "果蝇世界 — 会繁殖、会长大、会腐烂的桌面生态",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "check": "bun tools/check-syntax.js",
    "sim": "bun tools/simulate.js",
    "probe": "bun tools/probe-fly.js",
    "probe:forage": "bun tools/probe-forage.js",
    "icon": "electron tools/make-icon.js",
    "dist": "electron-builder --win --x64"
  },
  "author": "",
  "license": "MIT",
  "trustedDependencies": [
    "electron"
  ],
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.fruitflypet.desktop",
    "productName": "FruitFlyWorld",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "果蝇世界",
      "uninstallDisplayName": "果蝇世界",
      "artifactName": "FruitFlyWorld-Setup-${version}.exe",
      "language": "2052",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "FruitFlyWorld-${version}.exe"
    },
    "compression": "normal"
  }
}
